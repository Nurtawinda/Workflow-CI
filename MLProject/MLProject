name: Credit_Risk_Project

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      n_estimators: {type: int, default: 505}
      max_depth: {type: int, default: 37}
      dataset: {type: string, default: "credit_risk_dataset_preprocessing.csv"}
    command: "cmd /c python modelling_tuning.py {n_estimators} {max_depth} {dataset}"
